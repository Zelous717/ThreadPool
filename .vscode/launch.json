{
    "name": "g++调试",
    "type": "cppdbg",
    "request": "launch",
    "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
    "args": [],
    "stopAtEntry": false,
    "cwd": "${fileDirname}",
    "environment": [],
    "externalConsole": true,
    "MIMode": "gdb",
    "miDebuggerPath": "gdb.exe",
    "setupCommands": [
        {
            "description": "启用自动格式化",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        }
    ]
}
